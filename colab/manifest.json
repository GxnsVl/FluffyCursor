{
  "manifest_version": 3,
  "name": "Fluffy Cursor for Google Colab",
  "version": "1.0.0",
  "description": "Open-source elastic caret with glow and live color/motion settings for Google Colab. Local visual overlay; no notebook changes.",
  "minimum_chrome_version": "109",
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "permissions": [
    "storage"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://colab.research.google.com/*"
      ],
      "js": [
        "physics.js",
        "renderer.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Fluffy Cursor settings",
    "default_popup": "popup.html"
  },
  "options_ui": {
    "page": "popup.html",
    "open_in_tab": true
  },
  "homepage_url": "https://github.com/GxnsVl/FluffyCursor",
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'"
  },
  "key": ""
}
